{
  "openapi": "3.1.0",
  "info": {
    "title": "pydiggs HTTP API",
    "summary": "Validate DIGGS documents (XSD, dictionaries, Schematron).",
    "version": "1"
  },
  "paths": {
    "/v1/validate": {
      "post": {
        "tags": [
          "pydiggs"
        ],
        "summary": "Validate one DIGGS document",
        "operationId": "validate",
        "responses": {
          "200": {
            "description": "A diggs-findings 1.0 document (or a SARIF 2.1.0 log). Malformed XML, truncation and an exhausted time budget are 200s with findings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiggsFindingsDocument"
                }
              },
              "application/sarif+json": {
                "schema": {
                  "$ref": "#/components/schemas/SarifLog"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "406": {
            "description": "Accept allows neither JSON nor SARIF",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than the limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type, or compressed input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameter, or unreadable input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (fixed text and a correlation id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Busy (see Retry-After) or not ready",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "Validation passed the hard time limit (process isolation)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "File name to report (reduced to a basename)."
          },
          {
            "name": "checks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(context|deprecation|dictionary|geometry|schema|schematron|structure)(,(context|deprecation|dictionary|geometry|schema|schematron|structure))*$",
              "maxLength": 512
            },
            "description": "Comma-separated steps to run (default: all)."
          },
          {
            "name": "diggs_version",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "2.5.a",
                "2.6",
                "3.0.0"
              ]
            },
            "description": "DIGGS version (default: detected)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/xml": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "checks": {
                    "type": "string",
                    "pattern": "^(context|deprecation|dictionary|geometry|schema|schematron|structure)(,(context|deprecation|dictionary|geometry|schema|schematron|structure))*$",
                    "maxLength": 512
                  },
                  "diggs_version": {
                    "enum": [
                      "2.5.a",
                      "2.6",
                      "3.0.0"
                    ]
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "application/xml, text/xml, */*"
                }
              }
            }
          }
        }
      }
    },
    "/v1/versions": {
      "get": {
        "tags": [
          "pydiggs"
        ],
        "summary": "Versions of pydiggs, the findings schema and the bundled data",
        "operationId": "versions",
        "responses": {
          "200": {
            "description": "Versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versions"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (fixed text and a correlation id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rules": {
      "get": {
        "tags": [
          "pydiggs"
        ],
        "summary": "The rule catalogue",
        "operationId": "listRules",
        "responses": {
          "200": {
            "description": "The rule catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RuleInfo"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameter, or unreadable input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (fixed text and a correlation id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "structure",
                "schema",
                "codeType",
                "dictionary",
                "schematron",
                "geometry",
                "crs",
                "coordinate",
                "deprecation",
                "context"
              ]
            },
            "description": "Only the rules of this step."
          }
        ]
      }
    },
    "/v1/rules/{rule_id}": {
      "get": {
        "tags": [
          "pydiggs"
        ],
        "summary": "Explain one rule id",
        "operationId": "explainRule",
        "responses": {
          "200": {
            "description": "The rule (``known: false`` for a valid id pydiggs does not emit)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleInfo"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameter, or unreadable input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error (fixed text and a correlation id)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "rule_id",
            "in": "path",
            "required": true,
            "description": "A rule id, <step>.<name>.",
            "schema": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(structure|schema|codeType|dictionary|schematron|geometry|crs|coordinate|deprecation|context)\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        ]
      }
    },
    "/v1/readyz": {
      "get": {
        "tags": [
          "pydiggs"
        ],
        "summary": "Readiness: 200 once the workers are warm",
        "operationId": "readyzV1",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Busy (see Retry-After) or not ready",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/livez": {
      "get": {
        "summary": "Liveness: 200 while the server runs",
        "operationId": "livez",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness: 200 once the workers are warm",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Busy (see Retry-After) or not ready",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiggsFindingsCommit": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,64}$"
      },
      "DiggsFindingsCounts": {
        "type": "object",
        "required": [
          "error",
          "warning",
          "info"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "integer",
            "minimum": 0
          },
          "warning": {
            "type": "integer",
            "minimum": 0
          },
          "info": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DiggsFindingsDocument": {
        "title": "diggs-findings 1.0",
        "description": "Validation findings for DIGGS instance files, as written by pydiggs (pydiggs validate --format json). A new optional field is a 1.1; renaming or removing a field is a 2.0.",
        "type": "object",
        "required": [
          "$schema",
          "format",
          "schema_version",
          "tool",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "const": "https://xinp-hub.github.io/pydiggs/schemas/diggs-findings-1.0.schema.json"
          },
          "format": {
            "const": "diggs-findings"
          },
          "schema_version": {
            "type": "string",
            "pattern": "^1\\.[0-9]+$",
            "description": "Major.minor version of this schema the document follows."
          },
          "tool": {
            "type": "object",
            "required": [
              "name",
              "version",
              "reference_data"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "reference_data": {
                "description": "Upstream commit of each vendored DIGGS reference-data source (from PROVENANCE.toml).",
                "type": "object",
                "properties": {
                  "schemas": {
                    "$ref": "#/components/schemas/DiggsFindingsCommit"
                  },
                  "def": {
                    "$ref": "#/components/schemas/DiggsFindingsCommit"
                  },
                  "diggs-examples": {
                    "$ref": "#/components/schemas/DiggsFindingsCommit"
                  }
                },
                "additionalProperties": {
                  "$ref": "#/components/schemas/DiggsFindingsCommit"
                }
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiggsFindingsFile"
            }
          }
        }
      },
      "DiggsFindingsFile": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "diggs_version",
          "status",
          "verdict",
          "steps",
          "counts",
          "findings"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the working directory when the file is under it, else the bare file name; absolute only when asked for."
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "diggs_version": {
            "description": "DIGGS profile the file was checked as (2.5.a, 2.6, 3.0.0), or null when it could not be told or the file is not DIGGS.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "checked",
              "not-diggs",
              "unreadable"
            ],
            "description": "not-diggs: the root element is not a DIGGS Diggs element; only the structure step ran."
          },
          "verdict": {
            "enum": [
              "valid",
              "valid-with-warnings",
              "not-valid",
              "partly-checked",
              "not-diggs",
              "unreadable"
            ],
            "description": "Derived from status, steps and findings: not-diggs or unreadable from the status; else not-valid if any finding is an error; else partly-checked if a step is partial or incomplete; else valid-with-warnings if any finding is a warning; else valid."
          },
          "error": {
            "type": "string",
            "description": "Why an unreadable file could not be read."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "step",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "step": {
                  "$ref": "#/components/schemas/DiggsFindingsStep"
                },
                "status": {
                  "enum": [
                    "passed",
                    "partial",
                    "failed",
                    "skipped",
                    "incomplete"
                  ],
                  "description": "partial: no error, but part of the step could not be checked offline (dictionary.offline); incomplete: the step could not finish, or lost findings to max_findings (see the structure.findings-truncated finding). A step with an error is failed (or incomplete), never partial."
                }
              }
            }
          },
          "counts": {
            "$ref": "#/components/schemas/DiggsFindingsCounts"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiggsFindingsFinding"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unreadable"
                }
              }
            },
            "then": {
              "required": [
                "error"
              ],
              "properties": {
                "sha256": {
                  "type": "null"
                },
                "verdict": {
                  "const": "unreadable"
                },
                "findings": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "error"
                ]
              },
              "properties": {
                "sha256": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not-diggs"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "const": "not-diggs"
                },
                "diggs_version": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "checked"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "enum": [
                    "valid",
                    "valid-with-warnings",
                    "not-valid",
                    "partly-checked"
                  ]
                }
              }
            }
          }
        ]
      },
      "DiggsFindingsFinding": {
        "type": "object",
        "required": [
          "layer",
          "step",
          "rule_id",
          "severity",
          "message",
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "layer": {
            "enum": [
              "native",
              "official"
            ]
          },
          "step": {
            "$ref": "#/components/schemas/DiggsFindingsStep"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^(structure|schema|codeType|dictionary|schematron|geometry|crs|coordinate|deprecation|context)\\.[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "Stable id; the part before the first dot equals step."
          },
          "severity": {
            "$ref": "#/components/schemas/DiggsFindingsSeverity"
          },
          "message": {
            "type": "string",
            "description": "Human-readable text. Never compare it; compare rule_id and location."
          },
          "location": {
            "type": "object",
            "required": [
              "line",
              "column",
              "xpath",
              "gml_id"
            ],
            "additionalProperties": false,
            "properties": {
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "column": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "xpath": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Element path in the official diggs:get-path form, e.g. /diggs:Diggs[1]/diggs:samplingFeature[2]."
              },
              "gml_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "gml:id of the nearest element at or above the problem."
              }
            }
          },
          "source_snippet": {
            "type": "string",
            "maxLength": 1024,
            "description": "The offending element's XML, at most 1 KiB; present only when snippets were asked for."
          }
        }
      },
      "DiggsFindingsSeverity": {
        "enum": [
          "error",
          "warning",
          "info"
        ]
      },
      "DiggsFindingsStep": {
        "enum": [
          "structure",
          "schema",
          "codeType",
          "dictionary",
          "schematron",
          "geometry",
          "crs",
          "coordinate",
          "deprecation",
          "context"
        ]
      },
      "Problem": {
        "title": "Problem",
        "description": "RFC 9457 problem details. Switch on `code`; every text is fixed.",
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "enum": [
              "busy",
              "compressed-input",
              "cross-site",
              "input-too-large",
              "input-unreadable",
              "internal",
              "invalid-host",
              "invalid-multipart",
              "invalid-parameter",
              "method-not-allowed",
              "missing-input",
              "not-acceptable",
              "not-found",
              "not-ready",
              "resource-error",
              "timeout",
              "unsupported-media-type"
            ]
          },
          "errors": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "parameter",
                "problem"
              ],
              "properties": {
                "parameter": {
                  "type": "string"
                },
                "problem": {
                  "type": "string"
                }
              }
            }
          },
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "Ready": {
        "title": "Ready",
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "RuleInfo": {
        "title": "RuleInfo",
        "description": "One rule id pydiggs can emit (or an open family, as a pattern).",
        "type": "object",
        "required": [
          "id",
          "pattern",
          "step",
          "description",
          "severities",
          "help_uri",
          "known"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "enum": [
              "structure",
              "schema",
              "codeType",
              "dictionary",
              "schematron",
              "geometry",
              "crs",
              "coordinate",
              "deprecation",
              "context"
            ]
          },
          "description": {
            "type": "string"
          },
          "severities": {
            "type": "array",
            "items": {
              "enum": [
                "error",
                "warning",
                "info"
              ]
            }
          },
          "help_uri": {
            "type": "string"
          },
          "known": {
            "type": "boolean"
          }
        }
      },
      "SarifLog": {
        "title": "SARIF 2.1.0 log",
        "description": "A SARIF 2.1.0 log with one run (sent for Accept: application/sarif+json).",
        "type": "object",
        "required": [
          "version",
          "runs"
        ],
        "properties": {
          "version": {
            "const": "2.1.0"
          },
          "runs": {
