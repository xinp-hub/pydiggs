<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/propertylists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="propertyClass">
    <gml:description>This dictionary defines the factor names carried by the parameterName property of a diggs:DesignFactor object (core/Common.xsd). Two families of entry are present: partial and global safety factors (Design Parameter Analysis Group A row 11) and geosynthetic reduction factors A1-A5 plus the combined material factor f_m (Group G row 65, reused by row 93's durability RF chain). What each factor is applied to is carried separately, by diggs:DesignFactor/appliesTo (see the appliesTo.xml codelist) - splitting factor identity from what it is applied to is the reason diggs:DesignFactor exists rather than a bare AuthorizedParameter array; see DesignFactor's own schema documentation.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml</gml:identifier>
    <gml:name>DIGGS Design Factor Properties</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_permanent_unfavourable">
            <gml:description>Partial factor applied to an unfavourable (destabilising) permanent action, gamma_G, per a Eurocode 7 or equivalent partial-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_permanent_unfavourable</gml:identifier>
            <gml:name>Partial factor, unfavourable permanent action</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_permanent_favourable">
            <gml:description>Partial factor applied to a favourable (stabilising) permanent action, gamma_G,fav, per a Eurocode 7 or equivalent partial-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_permanent_favourable</gml:identifier>
            <gml:name>Partial factor, favourable permanent action</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_variable_unfavourable">
            <gml:description>Partial factor applied to an unfavourable (destabilising) variable action, gamma_Q, per a Eurocode 7 or equivalent partial-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_variable_unfavourable</gml:identifier>
            <gml:name>Partial factor, unfavourable variable action</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_material_friction_angle">
            <gml:description>Partial factor applied to the characteristic soil friction angle (tan phi'), gamma_phi', per a Eurocode 7 Design Approach 3 or equivalent material-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_material_friction_angle</gml:identifier>
            <gml:name>Partial factor, friction angle</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_material_cohesion">
            <gml:description>Partial factor applied to the characteristic soil cohesion or undrained shear strength, gamma_c', per a Eurocode 7 Design Approach 3 or equivalent material-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_material_cohesion</gml:identifier>
            <gml:name>Partial factor, cohesion</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="partial_factor_resistance">
            <gml:description>Partial factor applied to a calculated geotechnical resistance - bearing, sliding or pull-out - gamma_R, per a Eurocode 7 Design Approach 2 or equivalent resistance-factor design approach.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#partial_factor_resistance</gml:identifier>
            <gml:name>Partial factor, resistance</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>EN 1997-1</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="global_factor_of_safety">
            <gml:description>A single global factor of safety applied to an ultimate capacity, per an allowable-stress (working-stress) design approach rather than a partial-factor framework.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#global_factor_of_safety</gml:identifier>
            <gml:name>Global factor of safety</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="reduction_factor_creep">
            <gml:description>The geosynthetic reduction factor for creep, conventionally labelled A1, applied to the characteristic tensile strength to derive the long-term design strength.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#reduction_factor_creep</gml:identifier>
            <gml:name>Reduction factor, creep (A1)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="reduction_factor_installation_damage">
            <gml:description>The geosynthetic reduction factor for installation damage, conventionally labelled A2, applied to the characteristic tensile strength to derive the long-term design strength.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#reduction_factor_installation_damage</gml:identifier>
            <gml:name>Reduction factor, installation damage (A2)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="reduction_factor_weathering">
            <gml:description>The geosynthetic reduction factor for weathering (environmental/UV degradation prior to burial), conventionally labelled A3, applied to the characteristic tensile strength to derive the long-term design strength.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#reduction_factor_weathering</gml:identifier>
            <gml:name>Reduction factor, weathering (A3)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="reduction_factor_chemical_degradation">
            <gml:description>The geosynthetic reduction factor for chemical or biological degradation in service, conventionally labelled A4, applied to the characteristic tensile strength to derive the long-term design strength.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#reduction_factor_chemical_degradation</gml:identifier>
            <gml:name>Reduction factor, chemical/biological degradation (A4)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="reduction_factor_joints_seams">
            <gml:description>The geosynthetic reduction factor for joints and seams, conventionally labelled A5, applied to the characteristic tensile strength to derive the long-term design strength.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#reduction_factor_joints_seams</gml:identifier>
            <gml:name>Reduction factor, joints and seams (A5)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="material_partial_factor_geosynthetic">
            <gml:description>The combined material partial factor f_m applied to a geosynthetic's long-term design strength, distinct from the individual A1-A5 reduction factors it may be built from.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/design_factor_properties.xml#material_partial_factor_geosynthetic</gml:identifier>
            <gml:name>Geosynthetic material partial factor (f_m)</gml:name>
            <diggs:dataType>double</diggs:dataType>
            <diggs:quantityClass>dimensionless</diggs:quantityClass>
            <diggs:authority>BS 8006-1:2010+A1:2016</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:parameterName</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:DesignFactor</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
