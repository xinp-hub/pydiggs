<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="settlementComponent">
    <gml:description>Codes for which component of settlement a diggs:PredictedSettlement value is - immediate, primary consolidation, secondary/creep, total, or a further breakdown per the DFI paper cited by the schema documentation (LTP compression, RI elastic shortening, bearing-stratum settlement). Mandatory. Used for the value of diggs:PredictedSettlementType/diggs:settlementComponent.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml</gml:identifier>
    <gml:name>DIGGS Predicted Settlement Component Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="immediate">
            <gml:description>Settlement occurring immediately (elastically) upon load application, before any consolidation.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#immediate</gml:identifier>
            <gml:name>Immediate settlement</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="primary_consolidation">
            <gml:description>Settlement from primary consolidation of the compressible soil over time.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#primary_consolidation</gml:identifier>
            <gml:name>Primary consolidation settlement</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="secondary_creep">
            <gml:description>Long-term settlement from secondary compression (creep) after primary consolidation is substantially complete.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#secondary_creep</gml:identifier>
            <gml:name>Secondary (creep) settlement</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="total">
            <gml:description>The sum of all settlement components - the overall predicted settlement.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#total</gml:identifier>
            <gml:name>Total settlement</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="ltp_compression">
            <gml:description>Settlement from compression of the load transfer platform fill itself.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#ltp_compression</gml:identifier>
            <gml:name>LTP compression</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="elastic_shortening">
            <gml:description>Settlement from elastic axial shortening of the rigid inclusion column under load, including downdrag where a neutral plane is present.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#elastic_shortening</gml:identifier>
            <gml:name>RI elastic shortening</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="bearing_stratum_settlement">
            <gml:description>Settlement of the competent stratum below the column toe under the transferred load.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/settlementComponent.xml#bearing_stratum_settlement</gml:identifier>
            <gml:name>Bearing-stratum settlement</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:PredictedSettlement/diggs:settlementComponent</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
