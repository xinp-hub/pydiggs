<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="gridPattern">
    <gml:description>Codes naming the plan arrangement of rigid inclusion columns within a design. These codes are used for the value of the gridPattern property of the diggs:DesignRIColumn object. Where the design's scope carries a plannedPositions grid, the grid's offsetVectors define the lattice exactly and this code merely names what they already express; where scope carries no grid, this property and the column spacings are the prevailing statement of the layout. The list is open.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml</gml:identifier>
    <gml:name>DIGGS Rigid Inclusion Grid Pattern Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="square">
            <gml:description>Columns arranged on a square grid, with equal centre-to-centre spacing along both axes.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml#square</gml:identifier>
            <gml:name>Square grid</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignRIColumn/diggs:gridPattern</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="rectangular">
            <gml:description>Columns arranged on a rectangular grid, with differing centre-to-centre spacing along the two axes (spacingX and spacingY).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml#rectangular</gml:identifier>
            <gml:name>Rectangular grid</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignRIColumn/diggs:gridPattern</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="triangular">
            <gml:description>Columns arranged on a triangular grid, offset by half the spacing between alternating rows.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml#triangular</gml:identifier>
            <gml:name>Triangular grid</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignRIColumn/diggs:gridPattern</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="staggered">
            <gml:description>Columns arranged in parallel rows with each row offset from its neighbours by a fraction of the row spacing, without forming a regular triangular lattice.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml#staggered</gml:identifier>
            <gml:name>Staggered grid</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignRIColumn/diggs:gridPattern</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="irregular">
            <gml:description>Columns arranged without a repeating geometric pattern; used where layout is governed by obstructions, structural loading, or other non-uniform criteria.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/gridPattern.xml#irregular</gml:identifier>
            <gml:name>Irregular</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignRIColumn/diggs:gridPattern</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
