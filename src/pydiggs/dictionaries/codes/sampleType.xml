<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="type">
    <gml:description>Controlled vocabulary for diggs:SampleType/type, describing sample form only - the physical means by which a material sample was obtained (tube, drive, core, bulk, block, or fluid/gas extraction technique). Deliberately excludes sample class, sampler brand, insertion method, condition and purpose, each already modeled as its own diggs:Sample property (classification, samplerInsertionMethod, condition, purpose) or, for proprietary sampler brands, as an AlternateNames synonym on the relevant term here rather than a first-class code. Anchored on ISO 22475-1:2021 and the AGS4.2 SAMP_TYPE vocabulary rather than ASTM designations, since ASTM's sampling-practice family (D1587, D3550, D2113, D4220) has been withdrawn wholesale with no ASTM replacement named; an ASTM designation is cited as a secondary anchor only where one still stands. Not bound to diggs:DesignSampleType - that type deliberately has no type-equivalent property (see its own documentation in core/Core.xsd), so this vocabulary serves the as-built diggs:Sample object only.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/sampleType.xml</gml:identifier>
    <gml:name>DIGGS Sample Type</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="open_tube">
            <gml:description>Thin- or thick-walled tube sample recovered by static or dynamic push without a separating piston.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/sampleType.xml#open_tube</gml:identifier>
            <gml:name>Open-tube (open-drive) sample</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>ISO 22475-1</diggs:authority>
            <diggs:reference>https://www.iso.org/standard/71002.html</diggs:reference>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:Sample/diggs:type</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="thin_walled_tube">
