<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="separationBasis">
    <gml:description>Codes naming how the distance between two features is measured, for the value of separationBasis on diggs:ClearanceConstraint. Needed because two features' location geometries do not by themselves say which two points a stated separation distance is taken between.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml</gml:identifier>
    <gml:name>DIGGS Separation Measurement Basis Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="centerline_to_centerline">
            <gml:description>Distance measured between the centerlines (or center points) of the two features, ignoring their physical width or diameter.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml#centerline_to_centerline</gml:identifier>
            <gml:name>Centerline to centerline</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:separationBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="edge_to_edge">
            <gml:description>Distance measured between the nearest edges or surfaces of the two features - the clear gap between them.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml#edge_to_edge</gml:identifier>
            <gml:name>Edge to edge</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:separationBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="nearest_point">
            <gml:description>Distance measured between whichever two points on the two features are closest to each other, without regard to a consistent reference such as centerline or edge.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml#nearest_point</gml:identifier>
            <gml:name>Nearest point</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:separationBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="plan_view_distance">
            <gml:description>Horizontal distance in plan view between the two features, disregarding any difference in elevation or depth.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml#plan_view_distance</gml:identifier>
            <gml:name>Plan-view distance</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:separationBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="slant_distance">
            <gml:description>True three-dimensional distance between the two features, including any difference in elevation or depth.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/separationBasis.xml#slant_distance</gml:identifier>
            <gml:name>Slant distance</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:ClearanceConstraint/diggs:separationBasis</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
