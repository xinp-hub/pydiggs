                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="concrete_pile">
            <gml:description>A driven, cast-in-place, or precast pile made from concrete.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#concrete_pile</gml:identifier>
            <gml:name>Concrete pile</gml:name>
            <diggs:dataType>string</diggs:dataType>
