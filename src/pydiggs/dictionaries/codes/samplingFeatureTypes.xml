            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="gp_multi_track">
            <gml:description>A sampling feature representing multiple geophysical survey tracks recorded together as a single feature.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#gp_multi_track</gml:identifier>
            <gml:name>Geophysical multi-track</gml:name>
