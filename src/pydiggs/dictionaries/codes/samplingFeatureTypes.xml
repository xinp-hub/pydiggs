    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="timber_pile">
            <gml:description>A driven pile made from timber.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#timber_pile</gml:identifier>
