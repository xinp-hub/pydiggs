                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="ri_column">
            <gml:description>A single rigid inclusion column (CMC) - the location and properties of one column in a rigid inclusion ground improvement program.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#ri_column</gml:identifier>
            <gml:name>RI column</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
