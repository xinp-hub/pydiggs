                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="load_transfer_platform">
            <gml:description>The compacted granular layer, usually reinforced with geosynthetics, constructed over a field of rigid inclusions to distribute structural loads onto the column heads.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#load_transfer_platform</gml:identifier>
            <gml:name>Load transfer platform</gml:name>
