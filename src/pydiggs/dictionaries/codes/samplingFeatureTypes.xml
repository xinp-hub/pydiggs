                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="well">
            <gml:description>An installation within a borehole or sounding, used for observing, withdrawing, or injecting fluids. Wells are discrete sampling features in their own right but reference the parent borehole or sounding through the mandatory samplingFeatureRef.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#well</gml:identifier>
            <gml:name>Well</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
