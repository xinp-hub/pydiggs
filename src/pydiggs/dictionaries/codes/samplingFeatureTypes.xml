                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="trench_wall">
            <gml:description>A wall of a trench or pit dug into the ground, represented by a planar or multi-planar surface geometry. Preferred over trial_pit where 2D detail on the pit or trench wall is recorded.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#trench_wall</gml:identifier>
            <gml:name>Trench wall</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
