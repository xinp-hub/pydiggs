    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="planar_sampling_feature">
            <gml:description>A generic 2D sampling feature representing a planar sampling space - a cross-section or map, single-surface or made of multiple coplanar patches - that is not already a more specific named planar sampling feature kind.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#planar_sampling_feature</gml:identifier>
            <gml:name>Planar sampling feature</gml:name>
