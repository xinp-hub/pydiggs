    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="volumetric_sampling_feature">
            <gml:description>A generic 3D sampling feature representing a volume that defines the sampling space, using Solid geometry, that is not already a more specific named volumetric sampling feature kind.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#volumetric_sampling_feature</gml:identifier>
