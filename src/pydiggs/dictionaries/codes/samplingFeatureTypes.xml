        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="ri_treatment_area">
            <gml:description>The area of a site treated by a rigid inclusion ground improvement program - the ground improvement footprint that includes the rigid inclusion columns and may extend beyond any associated foundation or embankment.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#ri_treatment_area</gml:identifier>
            <gml:name>RI treatment area</gml:name>
