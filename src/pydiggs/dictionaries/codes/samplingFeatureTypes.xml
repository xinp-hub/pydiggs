<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="samplingFeatureType">
    <gml:description>Codes naming the kind of sampling feature a design applies to. Used for the value of samplingFeatureType on AbstractSamplingFeatureDesignType and its specializations, and of appliesToFeatureType on AbstractProgramSpecificationType and its specializations. Covers both plain sampling features and installation-type sampling features in one vocabulary, since an installation is itself a sampling feature in DIGGS (AbstractLinearInstallation and AbstractPlanarInstallation both substitute AbstractSamplingFeature directly) - there is no separate installation-type head to key a second dictionary on. The list is every concrete sampling feature kind in the schema; a future schema addition that substitutes AbstractSamplingFeature should get a matching entry here.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml</gml:identifier>
    <gml:name>DIGGS Sampling Feature Types Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="borehole">
            <gml:description>A deep, narrow excavation made by drilling and/or extraction of earth material, for investigating subsurface geologic or geotechnical conditions, exploring for water or oil, or for installation of wells or other downhole monitoring installations.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#borehole</gml:identifier>
            <gml:name>Borehole</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:samplingFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="sounding">
            <gml:description>A sampling feature created by a measurement or construction activity through insertion of a probe or tool into the ground.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#sounding</gml:identifier>
            <gml:name>Sounding</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:samplingFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="trial_pit">
            <gml:description>A relatively shallow excavation into the earth's surface, dug manually or by a mechanical excavator, referenced in a linear (1D) system only. Legacy, to support AGS trial pit constructs - see trench_wall for 2D detail on pit or trench walls.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#trial_pit</gml:identifier>
            <gml:name>Trial pit</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:samplingFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="transect">
            <gml:description>A generic linear sampling feature that extends along the surface of an investigation target, used for features such as geophysical arrays or measured sections that are not already a more specific named sampling feature kind.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#transect</gml:identifier>
            <gml:name>Transect</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:samplingFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="gp_trackline">
            <gml:description>A linear sampling feature recording the geographic location of a geophysical survey modelled as a single linestring - a ground-surface transect, marine trackline, or airborne flightline along which receivers, and optionally source devices, are placed or moved. Distinguished from a plain transect by its association with a geophysical field survey.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#gp_trackline</gml:identifier>
            <gml:name>Geophysical trackline</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:samplingFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:appliesToFeatureType</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="grout_trench_cutoff_wall">
            <gml:description>A linear sampling feature representing a grouted cutoff wall constructed in a trench.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#grout_trench_cutoff_wall</gml:identifier>
            <gml:name>Grout trench cutoff wall</gml:name>
