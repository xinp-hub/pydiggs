    <gml:dictionaryEntry>
        <diggs:Definition gml:id="steel_pipe_pile">
            <gml:description>A driven or installed pile fabricated from steel pipe.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#steel_pipe_pile</gml:identifier>
            <gml:name>Steel pipe pile</gml:name>
