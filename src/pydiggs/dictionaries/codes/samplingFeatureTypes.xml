                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="station">
            <gml:description>A point in or on the earth's surface where observations or tests are performed, samples are collected, or monitoring devices are installed, and which is not already a more specific named point sampling feature kind.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplingFeatureTypes.xml#station</gml:identifier>
            <gml:name>Station</gml:name>
