<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="https://diggsml.org/def/stylesheets/codelists.xsl"?>

<gml:Dictionary xmlns:diggs="http://diggsml.org/schemas/3" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://diggsml.org/schemas/3 https://diggsml.org/schemas/3.0.0/Diggs.xsd" gml:id="samplerInsertionMethod">
    <gml:description>Codes classifying how a sampler is advanced into the ground, planned or realized - pushed, driven, rotated, vibrated. Used for the value of diggs:DesignSampleType/samplerInsertionMethod (planned) and diggs:AbstractSamplingActivityType/samplerInsertionMethod (as-built, currently realized only by diggs:SamplingActivity) so design and as-built share one vocabulary for the same concept.</gml:description>
    <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplerInsertionMethod.xml</gml:identifier>
    <gml:name>DIGGS Sampler Insertion Method Codelist Definitions</gml:name>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="pushed">
            <gml:description>Sampler advanced by static push (e.g. Shelby tube, ASTM D1587).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplerInsertionMethod.xml#pushed</gml:identifier>
            <gml:name>Pushed</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignSample/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:SamplingActivity/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="driven">
            <gml:description>Sampler advanced by hammer blows (e.g. split-spoon SPT, ASTM D1586).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplerInsertionMethod.xml#driven</gml:identifier>
            <gml:name>Driven</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignSample/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:SamplingActivity/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="rotated">
            <gml:description>Sampler advanced by rotation (e.g. rotary core barrel).</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplerInsertionMethod.xml#rotated</gml:identifier>
            <gml:name>Rotated</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignSample/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:SamplingActivity/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="vibrated">
            <gml:description>Sampler advanced by vibratory insertion.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/samplerInsertionMethod.xml#vibrated</gml:identifier>
            <gml:name>Vibrated</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:DesignSample/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:SamplingActivity/diggs:samplerInsertionMethod</diggs:sourceElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
</gml:Dictionary>
