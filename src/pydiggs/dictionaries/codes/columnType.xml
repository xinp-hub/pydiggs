    <gml:dictionaryEntry>
        <diggs:Definition gml:id="prefab_vibro_driven">
            <gml:description>A prefabricated (precast or steel) column installed by vibratory driving.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/columnType.xml#prefab_vibro_driven</gml:identifier>
