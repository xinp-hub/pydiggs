            <gml:description>A column formed by driving a closed-end casing or mandrel with a vibratory hammer and casting concrete in place.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/columnType.xml#cip_vibro_driven</gml:identifier>
