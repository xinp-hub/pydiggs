    <gml:dictionaryEntry>
        <diggs:Definition gml:id="vibro_concrete_column">
            <gml:description>A column formed by advancing a vibratory probe and placing concrete through it.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/columnType.xml#vibro_concrete_column</gml:identifier>
            <gml:name>Vibro concrete column (VCC)</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RIColumn/diggs:columnType</diggs:sourceElementXpath>
