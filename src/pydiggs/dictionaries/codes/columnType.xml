    <gml:dictionaryEntry>
        <diggs:Definition gml:id="grouted_stone_column">
            <gml:description>A column formed from stone or gravel that is grouted to give it rigidity, intermediate between an unbound aggregate pier and a fully cemented inclusion.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/columnType.xml#grouted_stone_column</gml:identifier>
            <gml:name>Grouted stone/gravel column</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RIColumn/diggs:columnType</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:RIColumn/diggs:riInstallationMethod[.='full displacement' or .='replacement']</diggs:conditionalElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RIColumnSpecification/diggs:columnType</diggs:sourceElementXpath>
