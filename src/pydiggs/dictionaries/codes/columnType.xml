        </diggs:Definition>
    </gml:dictionaryEntry>
    <gml:dictionaryEntry>
        <diggs:Definition gml:id="drilled_displacement_column">
            <gml:description>A column formed by a shaped displacement tool advanced with a rotary action, which pushes soil radially outward instead of removing it, and through which concrete or grout is placed as the tool is withdrawn. The most widely used rigid inclusion technique. Trade names in common use: Controlled Modulus Column (CMC, Menard); and Rigid Inclusion (RI), also marketed as GI, GeoConcrete Column (GCC), Controlled Stiffness Column (CSC) and Augered Pressure Grout Column (APGC) by Keller / Hayward Baker. Distinct from continuous_flight_hollow_auger, which removes spoil and is therefore a replacement technique.</gml:description>
            <gml:identifier codeSpace="https://diggsml.org/def/authorities.xml#DIGGS">https://diggsml.org/def/codes/DIGGS/0.1/columnType.xml#drilled_displacement_column</gml:identifier>
            <gml:name>Drilled displacement column</gml:name>
            <diggs:dataType>string</diggs:dataType>
            <diggs:authority>DIGGS</diggs:authority>
            <diggs:occurrences>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RIColumn/diggs:columnType</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:RIColumn/diggs:riInstallationMethod[.='full displacement' or .='partial displacement']</diggs:conditionalElementXpath>
                </diggs:Occurrence>
                <diggs:Occurrence>
                    <diggs:sourceElementXpath>//diggs:RIColumnSpecification/diggs:columnType</diggs:sourceElementXpath>
                    <diggs:conditionalElementXpath>ancestor::diggs:RIColumnSpecification/diggs:riInstallationMethod[.='full displacement' or .='partial displacement']</diggs:conditionalElementXpath>
                </diggs:Occurrence>
            </diggs:occurrences>
        </diggs:Definition>
    </gml:dictionaryEntry>
